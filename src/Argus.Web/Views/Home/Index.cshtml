@model IReadOnlyList<Argus.Web.Models.Status.ClientStatusViewModel>
@{
    ViewData["Title"] = "Status board";
}

<h1 class="h3 mb-3">Status board</h1>

<div id="board">
    <partial name="_Board" model="Model" />
</div>

@section Scripts {
    <script>
        // Live (AA-40): site.js raises argus:board-changed when Argus pushes a change; only the cards are reloaded.
        document.addEventListener("argus:board-changed", async () => {
            const board = document.getElementById("board");
            if (board.contains(document.activeElement) && document.activeElement.tagName === "INPUT") return; // keep a maintenance message being typed

            const response = await fetch("@Url.Action("Board")");
            if (response.ok && !response.redirected) board.innerHTML = await response.text(); // redirected = logged out: keep the old cards
        });
    </script>
}