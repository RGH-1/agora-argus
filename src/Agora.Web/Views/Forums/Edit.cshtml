@model Agora.Web.Models.Forums.EditForumViewModel
@{
    ViewData["Title"] = "Edit forum";
}
<div class="row justify-content-center"><div class="col-lg-7"><h1>Edit forum</h1><form asp-action="Edit" method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="5"></textarea><span asp-validation-for="Description" class="text-danger"></span></div><button class="btn btn-primary" type="submit">Save changes</button> <a class="btn btn-outline-secondary" asp-action="Mine">Cancel</a></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
