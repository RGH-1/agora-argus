@model Agora.Web.Models.Forums.EditForumViewModel
@{
    ViewData["Title"] = "Edit forum";
}
<div class="row justify-content-center"><div class="col-lg-7"><h1>Edit forum</h1><form asp-action="Edit" method="post" data-length-form><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea id="Description" name="Description" class="form-control" rows="5" data-length-field data-limit="500" data-label="Forum description">@Model.Description</textarea><div class="form-text" data-counter-for="Description"></div><span asp-validation-for="Description" class="text-danger" data-length-message-for="Description"></span></div><button class="btn btn-primary" type="submit">Save changes</button> <a class="btn btn-outline-secondary" asp-action="Mine">Cancel</a></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/post-form.js" asp-append-version="true"></script> }
