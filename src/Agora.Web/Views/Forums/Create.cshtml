@model Agora.Web.Models.Forums.CreateForumViewModel
@{
    ViewData["Title"] = "Create forum";
}
<div class="row justify-content-center"><div class="col-lg-7"><h1>Create forum</h1><p class="text-muted">New forums are reviewed before they become public.</p><form asp-action="Create" method="post" data-length-form><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="Name" class="form-label"></label><input id="Name" name="Name" value="@Model.Name" class="form-control" data-length-field data-limit="100" data-label="Forum name" /><div class="form-text" data-counter-for="Name"></div><span asp-validation-for="Name" class="text-danger" data-length-message-for="Name"></span></div><div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea id="Description" name="Description" class="form-control" rows="5" data-length-field data-limit="500" data-label="Forum description">@Model.Description</textarea><div class="form-text" data-counter-for="Description"></div><span asp-validation-for="Description" class="text-danger" data-length-message-for="Description"></span></div><button class="btn btn-primary" type="submit">Submit for review</button> <a class="btn btn-outline-secondary" asp-action="Mine">Cancel</a></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/post-form.js" asp-append-version="true"></script> }
