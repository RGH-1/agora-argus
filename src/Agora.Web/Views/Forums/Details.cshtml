@model Agora.Web.Models.Forums.ForumDetailsViewModel
@{
    ViewData["Title"] = Model.Forum.Name;
}
<p><a asp-action="Index">&larr; All forums</a></p>
<div class="d-flex justify-content-between align-items-start"><div class="forum-details"><h1 class="forum-text">@Model.Forum.Name</h1><p class="lead forum-text">@Model.Forum.Description</p><p class="text-muted">Created by @Model.Forum.Creator.DisplayName</p></div>@if (User.Identity?.IsAuthenticated == true) { <a class="btn btn-primary" asp-controller="Posts" asp-action="Create" asp-route-forumId="@Model.Forum.Id">Create post</a> }</div>
<hr /><h2>Posts</h2>
@if (Model.Posts.Count == 0) { <div class="alert alert-info">There are no posts in this forum yet.</div> }
else { <div class="list-group">@foreach (var post in Model.Posts) { <a class="list-group-item list-group-item-action post-card" asp-controller="Posts" asp-action="Details" asp-route-id="@post.Id"><div class="d-flex justify-content-between post-card-heading"><h3 class="h5 mb-1 post-title">@post.Title</h3><small>@post.CreatedAtUtc.ToLocalTime().ToString("g")</small></div><p class="mb-1 post-preview">@(post.Content.Length > 180 ? post.Content[..180] + "…" : post.Content)</p><small>By @post.Author.DisplayName · @(Model.LikeCounts.TryGetValue(post.Id, out var likeCount) ? likeCount : 0) @(Model.LikeCounts.TryGetValue(post.Id, out likeCount) && likeCount == 1 ? "like" : "likes")</small></a> }</div> }
