@model IReadOnlyList<Agora.Web.Data.Entities.Forum>
@{
    ViewData["Title"] = "Forums";
}
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Forums</h1>@if (User.Identity?.IsAuthenticated == true) { <a class="btn btn-primary" asp-action="Create">Create forum</a> }</div>
@if (Model.Count == 0)
{
    <div class="alert alert-info">No approved forums are available yet.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 g-3">
    @foreach (var forum in Model)
    {
        <div class="col"><div class="card h-100"><div class="card-body"><h2 class="h5"><a asp-action="Details" asp-route-id="@forum.Id">@forum.Name</a></h2><p class="card-text">@forum.Description</p><small class="text-muted">Created by @forum.Creator.DisplayName</small></div></div></div>
    }
    </div>
}
