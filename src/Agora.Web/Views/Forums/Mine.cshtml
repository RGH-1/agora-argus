
@model IReadOnlyList<Agora.Web.Data.Entities.Forum>

@{
    ViewData["Title"] = "My Forums";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>My Forums</h1>
    <a class="btn btn-primary" asp-action="Create">Create forum</a>
</div>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success" role="alert">
        @statusMessage
    </div>
}

<section id="my-forums-list" aria-live="polite"><partial name="_MineList" model="Model" /></section>
