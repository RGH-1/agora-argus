@model IReadOnlyList<Agora.Web.Data.Entities.Forum>
@if (Model.Count == 0)
{
    <div class="alert alert-info">You have not created any forums yet.</div>
}
else
{
    <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Name</th><th>Description</th><th>Status</th><th></th></tr></thead><tbody>
    @foreach (var forum in Model)
    {
        <tr data-forum-id="@forum.Id"><td class="forum-text">@forum.Name@if (forum.Status == Agora.Web.Data.Entities.ForumStatus.Rejected && !string.IsNullOrWhiteSpace(forum.RejectionReason)) { <div class="mt-2 text-danger small forum-text"><strong>Rejection reason:</strong> @forum.RejectionReason</div> }</td><td class="forum-text">@forum.Description</td><td><span class="badge text-bg-@(forum.Status == Agora.Web.Data.Entities.ForumStatus.Approved ? "success" : forum.Status == Agora.Web.Data.Entities.ForumStatus.Rejected ? "danger" : "warning")">@forum.Status</span></td><td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@forum.Id">Edit</a> <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@forum.Id">Delete</a></td></tr>
    }
    </tbody></table></div>
}
