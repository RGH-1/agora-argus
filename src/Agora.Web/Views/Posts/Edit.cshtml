@model Agora.Web.Models.Posts.EditPostViewModel
@{ ViewData["Title"] = "Edit post"; }
<div class="row justify-content-center"><div class="col-lg-8"><h1>Edit post</h1><form asp-action="Edit" method="post" data-post-form><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="Title" class="form-label"></label><input id="Title" name="Title" value="@Model.Title" class="form-control" data-post-field data-limit="150" data-label="Title" /><div id="TitleCounter" class="form-text" data-counter-for="Title"></div><span asp-validation-for="Title" class="text-danger" data-length-message-for="Title"></span></div><div class="mb-3"><label asp-for="Content" class="form-label"></label><textarea id="Content" name="Content" class="form-control" rows="10" data-post-field data-limit="4000" data-label="Content">@Model.Content</textarea><div id="ContentCounter" class="form-text" data-counter-for="Content"></div><span asp-validation-for="Content" class="text-danger" data-length-message-for="Content"></span></div><button class="btn btn-primary" type="submit">Save changes</button></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/post-form.js" asp-append-version="true"></script> }
