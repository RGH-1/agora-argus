@model Agora.Web.Data.Entities.Post
@{ ViewData["Title"] = "Delete post"; }
<h1>Delete post</h1><div class="alert alert-warning">Are you sure you want to remove <strong>@Model.Title</strong>? It will no longer be visible publicly.</div><form asp-action="Delete" method="post"><input type="hidden" name="id" value="@Model.Id" /><button class="btn btn-danger" type="submit">Remove post</button> <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancel</a></form>
