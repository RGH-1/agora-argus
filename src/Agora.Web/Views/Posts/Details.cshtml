@model Agora.Web.Data.Entities.Post
@{ ViewData["Title"] = Model.Title; var likeCount = (int?)ViewData["LikeCount"] ?? 0; var isLiked = (bool?)ViewData["IsLiked"] ?? false; }
<p><a asp-controller="Forums" asp-action="Details" asp-route-id="@Model.ForumId">&larr; Back to @Model.Forum.Name</a></p><article class="post-details"><h1 class="post-title">@Model.Title</h1><p class="text-muted">By @Model.Author.DisplayName on @Model.CreatedAtUtc.ToLocalTime().ToString("g")</p><div class="mb-4 post-body">@Model.Content</div><div class="mb-3">@if (User.Identity?.IsAuthenticated == true) { <form class="d-inline" asp-controller="Likes" asp-action="Toggle" method="post"><input type="hidden" name="postId" value="@Model.Id" /><button class="btn btn-outline-primary" type="submit">@(isLiked ? "Unlike" : "Like")</button></form> } else { <a class="btn btn-outline-primary" asp-controller="Account" asp-action="Login">Sign in to like</a> } <span class="ms-2 text-muted">@likeCount @(likeCount == 1 ? "like" : "likes")</span></div>@if (Model.UpdatedAtUtc > Model.CreatedAtUtc) { <p class="text-muted"><small>Last updated @Model.UpdatedAtUtc.ToLocalTime().ToString("g")</small></p> } @if (User.Identity?.IsAuthenticated == true && User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == Model.AuthorId) { <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a> <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">Delete</a> }</article>
