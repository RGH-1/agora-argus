@model Agora.Web.Models.Posts.PostDetailsViewModel
@{
    var post = Model.Post;
    var contentError = ViewData.ModelState["Content"]?.Errors.FirstOrDefault()?.ErrorMessage;
    var likeCount = (int?)ViewData["LikeCount"] ?? 0;
    var isLiked = (bool?)ViewData["IsLiked"] ?? false;
    ViewData["Title"] = post.Title;
}
<p><a asp-controller="Forums" asp-action="Details" asp-route-id="@post.ForumId">&larr; Back to @post.Forum.Name</a></p>
@if (TempData["StatusMessage"] is string statusMessage) { <div class="alert alert-success" role="alert">@statusMessage</div> }
<article class="post-details">
    <h1 class="post-title">@post.Title</h1>
    <p class="text-muted">By @post.Author.DisplayName <partial name="_ProBadge" model="post.Author.IsPro" /> on @post.CreatedAtUtc.ToLocalTime().ToString("g")</p>
    <div class="mb-4 post-body">@post.Content</div>
    <div class="mb-3">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <form class="d-inline" asp-controller="Likes" asp-action="Toggle" method="post">
                <input type="hidden" name="postId" value="@post.Id" />
                <button class="btn btn-outline-primary" type="submit">@(isLiked ? "Unlike" : "Like")</button>
            </form>
        }
        else
        {
            <a class="btn btn-outline-primary" asp-controller="Account" asp-action="Login">Sign in to like</a>
        }
        <span class="ms-2 text-muted">@likeCount @(likeCount == 1 ? "like" : "likes")</span>
    </div>
    @if (post.UpdatedAtUtc > post.CreatedAtUtc) { <p class="text-muted"><small>Last updated @post.UpdatedAtUtc.ToLocalTime().ToString("g")</small></p> }
    @if (User.Identity?.IsAuthenticated == true && User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == post.AuthorId)
    {
        <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@post.Id">Edit</a>
        <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@post.Id">Delete</a>
    }
    else if (User.Identity?.IsAuthenticated == true)
    {
        <a class="btn btn-outline-warning" asp-controller="Reports" asp-action="Create" asp-route-postId="@post.Id">Report</a>
    }
    else
    {
        <a class="btn btn-outline-warning" asp-controller="Account" asp-action="Login">Sign in to report</a>
    }
</article>

<section class="comments-section mt-4" aria-labelledby="comments-heading">
    <h2 id="comments-heading">Comments (@Model.Comments.Count)</h2>
    @if (Model.Comments.Count == 0)
    {
        <p class="text-muted">No comments yet. Start the conversation.</p>
    }
    else
    {
        @foreach (var comment in Model.Comments)
        {
            <article class="card mb-3 comment-card">
                <div class="card-body">
                    <p class="mb-2"><strong>@comment.Author.DisplayName</strong> <partial name="_ProBadge" model="comment.Author.IsPro" /> <span class="text-muted">on @comment.CreatedAtUtc.ToLocalTime().ToString("g")</span></p>
                    <div class="comment-body">@comment.Content</div>
                    @if (User.Identity?.IsAuthenticated == true && (User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == comment.AuthorId || User.IsInRole("Moderator") || User.IsInRole("Admin")))
                    {
                        <form asp-controller="Comments" asp-action="Delete" asp-route-id="@comment.Id" method="post" class="mt-3">
                            <button class="btn btn-sm btn-outline-danger" type="submit">Delete comment</button>
                        </form>
                    }
                </div>
            </article>
        }
    }

    @if (User.Identity?.IsAuthenticated == true)
    {
        if (Model.IsCurrentUserBanned)
        {
            <div class="alert alert-warning">Banned users cannot add comments.</div>
        }
        else
        {
            <form asp-controller="Comments" asp-action="Create" method="post" data-length-form class="mt-4">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="mb-3">
                    <label asp-for="NewComment.Content" class="form-label">Add a comment</label>
                    <textarea id="CommentContent" name="Content" class="form-control @(contentError is null ? "" : "is-invalid")" rows="5" data-length-field data-limit="2000" data-label="Comment">@Model.NewComment.Content</textarea>
                    <input name="PostId" type="hidden" value="@post.Id" />
                    <div class="form-text" data-counter-for="CommentContent"></div>
                    <span class="text-danger" data-length-message-for="CommentContent">@contentError</span>
                </div>
                <button class="btn btn-primary" type="submit">Add comment</button>
            </form>
        }
    }
    else
    {
        <p><a asp-controller="Account" asp-action="Login">Sign in</a> to add a comment.</p>
    }
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/post-form.js" asp-append-version="true"></script> }
