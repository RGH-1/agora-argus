@model Agora.Web.Models.Subscription.SubscriptionUpgradeViewModel
@{ ViewData["Title"] = "Agora Pay — Demo Gateway"; }
<div class="row justify-content-center my-4"><div class="col-lg-9 col-xl-8"><div class="d-flex align-items-center gap-2 mb-4"><span class="badge text-bg-primary fs-6 rounded-circle">A</span><div><h1 class="h3 mb-0">Agora Pay</h1><p class="text-muted mb-0">Demo Gateway</p></div></div>
@if (Model.IsPro)
{ <div class="alert alert-success">Your Agora Pro membership is already active. No further payment is needed.</div><a class="btn btn-primary" asp-controller="Forums" asp-action="Mine">Go to My Forums</a> }
else if (Model.IsBanned)
{ <div class="alert alert-warning">Banned accounts cannot upgrade to Agora Pro.</div> }
else
{ <div class="row g-4"><div class="col-md-7"><div class="card shadow-sm h-100"><div class="card-body p-4"><h2 class="h5">Demo payment method</h2><div class="border rounded p-3 bg-light mb-4"><div class="d-flex align-items-center gap-3"><span class="fs-3 text-primary" aria-hidden="true">▣</span><div><strong>Agora Demo Gateway</strong><div class="text-muted small">Approved simulation · No card details required</div></div></div></div><div class="alert alert-info small">This is a simulated checkout. No real money will be charged and no financial information is collected.</div><form asp-action="Checkout" method="post" data-demo-payment><button class="btn btn-primary btn-lg w-100" type="submit"><span class="payment-label">Confirm Demo Payment — $4.99</span><span class="payment-loading d-none"><span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Processing demo payment…</span></button></form></div></div></div><div class="col-md-5"><aside class="card border-primary shadow-sm"><div class="card-body p-4"><h2 class="h5">Order summary</h2><dl class="row mb-0"><dt class="col-7 fw-normal">Plan</dt><dd class="col-5 text-end">Agora Pro</dd><dt class="col-7 fw-normal">Unlimited forums</dt><dd class="col-5 text-end">Included</dd><dt class="col-7 fw-normal">Pro badge</dt><dd class="col-5 text-end">Included</dd><dt class="col-7 pt-3 border-top">Total</dt><dd class="col-5 pt-3 border-top text-end fw-bold">$4.99 USD</dd></dl></div></aside></div></div> }
</div></div>
@section Scripts { <script>document.querySelector('[data-demo-payment]')?.addEventListener('submit', function () { const button = this.querySelector('button'); button.disabled = true; button.querySelector('.payment-label').classList.add('d-none'); button.querySelector('.payment-loading').classList.remove('d-none'); });</script> }
