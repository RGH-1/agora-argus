@model Agora.Web.Models.Reports.CreateReportViewModel
@{ ViewData["Title"] = "Report post"; }
<div class="row justify-content-center"><div class="col-lg-8"><h1>Report post</h1><p class="text-muted">@ViewData["PostTitle"]</p><form asp-action="Create" method="post" data-length-form><input asp-for="PostId" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="Category" class="form-label">Reason</label><select asp-for="Category" class="form-select"><option value="">Select a reason</option>@foreach (var category in Agora.Web.Models.Reports.CreateReportViewModel.Categories) { <option value="@category">@category</option> }</select><span asp-validation-for="Category" class="text-danger"></span></div><div class="mb-3"><label asp-for="Details" class="form-label">Additional details (optional)</label><textarea id="Details" name="Details" class="form-control" rows="6" data-length-field data-limit="900" data-label="Additional details" data-optional="true">@Model.Details</textarea><div class="form-text" data-counter-for="Details"></div><span asp-validation-for="Details" class="text-danger" data-length-message-for="Details"></span></div><button class="btn btn-danger" type="submit">Submit report</button><a class="btn btn-outline-secondary" asp-controller="Posts" asp-action="Details" asp-route-id="@Model.PostId">Cancel</a></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/post-form.js" asp-append-version="true"></script> }
