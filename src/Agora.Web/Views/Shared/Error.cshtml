@model ErrorViewModel
@{ ViewData["Title"] = "Something went wrong"; }
<div class="card shadow-sm mx-auto my-5" style="max-width:42rem"><div class="card-body p-4"><h1 class="h2">Something went wrong</h1><p class="text-muted">We could not complete that request. Please try again later.</p><a class="btn btn-primary" asp-controller="Home" asp-action="Index">Go to Home</a> <a class="btn btn-outline-secondary" asp-controller="Forums" asp-action="Index">Browse forums</a>@if (Model.ShowRequestId) { <p class="small text-muted mt-3 mb-0">Request ID: @Model.RequestId</p> }</div></div>
