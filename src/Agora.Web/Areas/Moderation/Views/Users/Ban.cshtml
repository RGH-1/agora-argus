@model Agora.Web.Models.Moderation.UserBanFormViewModel
@{ ViewData["Title"] = "Ban user"; }
<h1>Ban @Model.DisplayName</h1><p>@Model.UserName · @Model.Email</p><form method="post" class="col-md-7" data-length-form><input asp-for="UserId" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="Reason" class="form-label">Reason</label><textarea id="Reason" name="Reason" class="form-control" rows="4" data-length-field data-limit="500" data-label="Reason">@Model.Reason</textarea><div class="form-text" data-counter-for="Reason"></div><span asp-validation-for="Reason" class="text-danger" data-length-message-for="Reason"></span></div><button class="btn btn-danger">Confirm ban</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></form><partial name="_ValidationScriptsPartial" /><script src="~/js/post-form.js" asp-append-version="true"></script>
