@model Agora.Web.Models.Moderation.UserManagementPageViewModel
@{ ViewData["Title"] = "Manage users"; }
<h1>Manage users</h1>
<form method="get" class="row g-2 mb-3"><div class="col-sm-6"><input name="search" value="@Model.Search" class="form-control" placeholder="Search name, username, or email" /></div><div class="col-auto"><button class="btn btn-primary">Search</button></div></form>
@{ var actorId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value; var actorIsAdmin = User.IsInRole("Admin"); }
@if (!Model.Users.Any()) { <p class="text-muted">No users match your search.</p> } else { <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Name</th><th>Username</th><th>Email</th><th>Roles</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach (var user in Model.Users) { var canChangeBan = Agora.Web.Models.Moderation.UserManagementActionPolicy.CanChangeBan(user, actorId, actorIsAdmin); var canChangeRole = Agora.Web.Models.Moderation.UserManagementActionPolicy.CanChangeModeratorRole(user, actorIsAdmin); <tr><td>@user.DisplayName</td><td>@user.UserName</td><td>@user.Email</td><td>@string.Join(", ", user.Roles)</td><td>@(user.IsBanned ? "Banned" : "Active")</td><td class="text-nowrap">@if (!canChangeBan && !canChangeRole) { <span class="text-muted">Protected</span> } else { @if (canChangeBan) { @if (user.IsBanned) { <a class="btn btn-sm btn-outline-success" asp-action="Unban" asp-route-id="@user.Id">Unban</a> } else { <a class="btn btn-sm btn-outline-danger" asp-action="Ban" asp-route-id="@user.Id">Ban</a> } } @if (canChangeRole) { <form class="d-inline" asp-action="@(user.Roles.Contains("Moderator") ? "RemoveModerator" : "GrantModerator")" method="post"><input type="hidden" name="userId" value="@user.Id" /><button class="btn btn-sm btn-outline-secondary">@(user.Roles.Contains("Moderator") ? "Remove moderator" : "Make moderator")</button></form> } }</td></tr> }</tbody></table></div> }
<a class="btn btn-outline-secondary @(Model.Page <= 1 ? "disabled" : "")" asp-route-search="@Model.Search" asp-route-page="@(Model.Page - 1)">Previous</a> @if (Model.HasNextPage) { <a class="btn btn-outline-secondary" asp-route-search="@Model.Search" asp-route-page="@(Model.Page + 1)">Next</a> }
