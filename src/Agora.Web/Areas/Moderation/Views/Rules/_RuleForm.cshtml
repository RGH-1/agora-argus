@model Agora.Web.Models.Rules.RuleFormViewModel
@{ var titleError = ViewData.ModelState["Title"]?.Errors.FirstOrDefault()?.ErrorMessage; var contentError = ViewData.ModelState["Content"]?.Errors.FirstOrDefault()?.ErrorMessage; }
<form method="post" class="col-lg-8" data-length-form><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="Title" class="form-label"></label><input id="Title" name="Title" value="@Model.Title" class="form-control @(titleError is null ? "" : "is-invalid")" data-length-field data-limit="150" data-label="Rule title" /><div class="form-text" data-counter-for="Title"></div><span asp-validation-for="Title" class="text-danger" data-length-message-for="Title">@titleError</span></div><div class="mb-3"><label asp-for="Content" class="form-label"></label><textarea id="Content" name="Content" class="form-control @(contentError is null ? "" : "is-invalid")" rows="8" data-length-field data-limit="2000" data-label="Rule content">@Model.Content</textarea><div class="form-text" data-counter-for="Content"></div><span asp-validation-for="Content" class="text-danger" data-length-message-for="Content">@contentError</span></div><button class="btn btn-primary" type="submit">Save rule</button><a class="btn btn-outline-secondary" asp-action="Index">Cancel</a></form>
