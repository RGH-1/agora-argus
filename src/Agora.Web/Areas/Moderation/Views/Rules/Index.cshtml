@model IReadOnlyList<Agora.Web.Data.Entities.Rule>
@{ ViewData["Title"] = "Manage rules"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="mb-0">Manage community rules</h1><a class="btn btn-primary" asp-action="Create">Add rule</a></div>
@if (TempData["StatusMessage"] is string statusMessage) { <div class="alert alert-success">@statusMessage</div> } @if (TempData["ErrorMessage"] is string errorMessage) { <div class="alert alert-warning">@errorMessage</div> }
@if (Model.Count == 0) { <div class="alert alert-info">There are no rules yet.</div> } else { <div class="table-responsive"><table class="table align-middle rules-management-table"><thead><tr><th>Order</th><th>Rule</th><th>Actions</th></tr></thead><tbody>@for (var index = 0; index < Model.Count; index++) { var rule = Model[index]; <tr><td>@(index + 1)</td><td class="rule-text"><strong>@rule.Title</strong><div class="mt-1 rule-preview">@rule.Content</div></td><td class="text-nowrap"><form asp-action="MoveUp" method="post" class="d-inline"><input type="hidden" name="id" value="@rule.Id" /><button class="btn btn-sm btn-outline-secondary" disabled="@(index == 0)">Move up</button></form> <form asp-action="MoveDown" method="post" class="d-inline"><input type="hidden" name="id" value="@rule.Id" /><button class="btn btn-sm btn-outline-secondary" disabled="@(index == Model.Count - 1)">Move down</button></form> <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@rule.Id">Edit</a> <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@rule.Id">Delete</a></td></tr> }</tbody></table></div> }
