@model IReadOnlyList<Agora.Web.Data.Entities.Forum>
@{ ViewData["Title"] = "Forum approval queue"; }
<h1>Forum approval queue</h1>
@if (TempData["StatusMessage"] is string statusMessage) { <div class="alert alert-success">@statusMessage</div> }
@if (TempData["ErrorMessage"] is string errorMessage) { <div class="alert alert-warning">@errorMessage</div> }
<div data-moderation-queue="forums">@if (Model.Count == 0) { <div class="alert alert-info">There are no forums waiting for review.</div> }
else { <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Forum</th><th>Creator</th><th>Submitted</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var forum in Model) { <tr><td><strong>@forum.Name</strong><br /><small class="text-muted">@forum.Description</small></td><td>@forum.Creator.DisplayName</td><td>@forum.SubmittedAtUtc.ToLocalTime().ToString("g")</td><td><span class="badge text-bg-warning">@forum.Status</span></td><td class="text-end"><form asp-action="Approve" method="post" class="d-inline"><input type="hidden" name="id" value="@forum.Id" /><button class="btn btn-sm btn-success" type="submit">Approve</button></form> <a class="btn btn-sm btn-outline-danger" asp-action="Reject" asp-route-id="@forum.Id">Reject</a></td></tr> }</tbody></table></div> }</div>
