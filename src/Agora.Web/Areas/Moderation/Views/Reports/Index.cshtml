@model IReadOnlyList<Agora.Web.Data.Entities.Report>
@using System.Text.Json
@using Agora.Web.Models.Moderation
@{ ViewData["Title"] = "Report queue"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="mb-0">Open reports</h1><a class="btn btn-outline-secondary" asp-action="History">Moderation history</a></div>
@if (TempData["StatusMessage"] is string statusMessage) { <div class="alert alert-success" role="alert">@statusMessage</div> }
@if (TempData["ErrorMessage"] is string errorMessage) { <div class="alert alert-warning" role="alert">@errorMessage</div> }
@if (Model.Count == 0) { <div class="alert alert-info">There are no open reports.</div> }
else { <div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>ID / Submitted</th><th>Reported post</th><th>Reporter / reason</th><th>Status</th><th>Actions</th></tr></thead><tbody>
@foreach (var report in Model) { var verdict = report.AiAssessment is { } assessment ? JsonSerializer.Deserialize<AiReportVerdict>(assessment, new JsonSerializerOptions(JsonSerializerDefaults.Web)) : null; <tr><td>#@report.Id<br /><small>@report.CreatedAtUtc.ToLocalTime().ToString("g")</small></td><td class="text-break" style="min-width: 18rem"><strong>@report.Post.Title</strong><br /><small class="text-muted">Author: @report.Post.Author.DisplayName</small><div class="mt-2" style="white-space: pre-wrap; overflow-wrap: anywhere">@report.Post.Content</div></td><td class="text-break" style="min-width: 14rem"><strong>@report.ReportingUser.DisplayName</strong><div class="mt-2" style="white-space: pre-wrap; overflow-wrap: anywhere">@report.Reason</div>@if (verdict is not null) { <div class="mt-2 small" style="white-space: pre-wrap; overflow-wrap: anywhere"><strong>AI assessment only — the Moderator makes the final decision.</strong><br /><strong>AI verdict:</strong> @(verdict.Violates ? "Possible violation" : "No violation detected")<br />@if (verdict.RuleBroken is not null) { <span><strong>Rule:</strong> @verdict.RuleBroken<br /></span> }<strong>Confidence:</strong> @verdict.Confidence.ToString("P0")<br /><strong>Explanation:</strong> @verdict.Explanation<br /><span class="text-muted">@report.AiAssessedAtUtc?.ToLocalTime().ToString("g")</span></div> } else { <small class="text-muted">Not checked yet</small> }</td><td>@report.Status</td><td><div class="d-flex flex-wrap gap-1"><form asp-action="AiCheck" method="post"><input type="hidden" name="reportId" value="@report.Id" /><button class="btn btn-sm btn-outline-primary" type="submit">AI check</button></form><form asp-action="Remove" method="post"><input type="hidden" name="reportId" value="@report.Id" /><button class="btn btn-sm btn-danger" type="submit">Remove post</button></form><form asp-action="Dismiss" method="post"><input type="hidden" name="reportId" value="@report.Id" /><button class="btn btn-sm btn-outline-secondary" type="submit">Dismiss</button></form><a class="btn btn-sm btn-outline-warning" asp-action="Warn" asp-route-reportId="@report.Id">Warn author</a><a class="btn btn-sm btn-outline-danger" asp-action="Ban" asp-route-reportId="@report.Id">Ban author</a></div></td></tr> }
</tbody></table></div> }
